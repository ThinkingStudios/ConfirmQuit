{
  "schemaVersion": 1,
  "id": "rusurequit",
  "version": "${version}",
  "name": "RuSureQuit",
  "description": "QuitConfirm unofficial multi-modloader port. Add a quit confirm screen/toast to avoid mistakenly quitting the game.",
  "authors": [
    "TexTrue", "ThinkingStudio", "CaaMoe", "Xiao_Cozi"
  ],
  "contact": {
    "sources": "https://github.com/ThinkingStudios/RuSureQuit"
  },
  "license": "MIT",
  "icon": "assets/rusurequit/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.thinkingstudio.rusurequit.client.fabric.RuSureQuitFabricClient"
    ],
    "modmenu": [
      "org.thinkingstudio.rusurequit.client.fabric.RuSureQuitModMenu"
    ]
  },
  "mixins": [
    "rusurequit.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": ">=1.21.6",
    "java": ">=17",
    "fabric-api": "*",
    "cloth-config": "*"
  }
}
