{
  "schemaVersion": 1,
  "id": "confirmquit",
  "version": "${version}",
  "name": "ConfirmQuit",
  "description": "QuitConfirm unofficial multi-modloader port. Add a quit confirm screen/toast to avoid mistakenly quitting the game.",
  "authors": [
    "TexTrue", "ThinkingStudio", "CaaMoe", "Xiao_Cozi"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "MIT",
  "icon": "assets/confirmquit/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.thinkingstudio.confirmquit.client.fabric.ConfirmQuitFabricClient"
    ],
    "modmenu": [
      "org.thinkingstudio.confirmquit.client.fabric.ConfirmQuitModMenu"
    ]
  },
  "mixins": [
    "confirmquit.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": ">=1.21.9",
    "java": ">=17",
    "fabric-api": "*",
    "cloth-config": "*"
  }
}
